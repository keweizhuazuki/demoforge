# Optional AI storyboard suggestions. No API key is needed for core features.
# Copy to ignored .env, fill locally, then: node --env-file=.env server/index.mjs
# Your brief and scene titles/captions are sent to your chosen provider.
# Enabling AI permits a paid request only when you click Suggest in the UI.
DEMOFORGE_AI_ENABLED=false
DEMOFORGE_AI_PROVIDER=openai
DEMOFORGE_AI_MODEL=your-model-id
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional own-app capture allowlist. Only this exact origin is permitted.
# Restart server after changing. UI confirmation is required for each selected target.
# Example: http://127.0.0.1:3000 (your app must already be running)
DEMOFORGE_TARGET_ORIGIN=
